{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YtHarbor",
  "version": "0.1.1",
  "identifier": "app.ytharbor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YtHarbor",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/yt-dlp"],
    "resources": ["resources/ffmpeg/*", "resources/deno/*"],
    "windows": {
      "wix": { "language": "zh-CN" },
      "nsis": { "installerIcon": "icons/icon.ico" }
    }
  }
}
